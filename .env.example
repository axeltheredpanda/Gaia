# Rempli aux étapes correspondantes de la roadmap — voir docs/PROJECT_SPEC.md
ANTHROPIC_API_KEY=

# Optionnel : clé API personnelle Linear (Settings > API dans Linear), utilisée
# directement comme Bearer token pour le MCP Linear sans passer par le flow
# OAuth popup ("Connecter Linear" dans la sidebar).
LINEAR_API_KEY=

# Stockage Supabase (spec 4.6) : historique de conversation (fenêtre glissante
# + résumé), faits mémoire durables, cache du badge HUD, et Supabase Vault
# pour les secrets OAuth. Optionnel — sans ça, le chat garde son historique en
# mémoire pour la session en cours seulement (pas de persistance entre
# lancements), et Linear reste connecté en mémoire seulement.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Recherche d'images (spec 4.4). Optionnel — sans ça, l'outil retombe sur
# Openverse (gratuit, sans clé, résultats moins précis). Clé API + moteur de
# recherche personnalisé (cx) configuré en mode "Image search" sur
# https://programmablesearchengine.google.com — 100 requêtes gratuites/jour.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
